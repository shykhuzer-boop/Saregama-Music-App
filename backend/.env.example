# ===========================================
# Saregama Backend — Environment Variables
# Copy this file to .env and fill in values
# ===========================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local:      mongodb://localhost:27017/saregama
# Atlas:      mongodb+srv://<user>:<pass>@cluster.mongodb.net/saregama
MONGODB_URI=mongodb://localhost:27017/saregama

# JWT
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-strong-secret-here-change-in-production
JWT_EXPIRES_IN=7d

# CORS — Frontend origin (no trailing slash)
CORS_ORIGIN=http://localhost:3000

# Google Gemini AI (for artwork generation)
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
RATE_LIMIT_MAX=100            # max requests per window (global)
AUTH_RATE_LIMIT_MAX=10        # max auth attempts per window
